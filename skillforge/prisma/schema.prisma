generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String              @id @default(cuid())
  name             String?
  email            String?             @unique
  password         String?
  college          String?
  targetRole       String?
  bio              String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  skills           Skill[]
  projects         Project[]
  interviews       Interview[]
  sessions         Session[]
  accounts         Account[]
  interviewSessions InterviewSession[]
  roadmaps         CareerRoadmap[]
  chatMessages     ChatMessage[]
  resumeData       ResumeData?
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  level     Int      @default(0)
  category  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String              @id @default(cuid())
  name        String
  description String?
  stack       String[]
  progress    Int                 @default(0)
  status      String              @default("active")
  githubUrl   String?
  liveUrl     String?
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  ProjectMilestone[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  title       String
  description String?
  completed   Boolean  @default(false)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Interview {
  id        String   @id @default(cuid())
  company   String
  role      String
  score     Int
  category  String
  notes     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model InterviewQuestion {
  id           String             @id @default(cuid())
  question     String
  category     String // DSA, Behavioral, System Design, HR, Company-specific
  difficulty   String // Easy, Medium, Hard
  company      String? // If company-specific
  sampleAnswer String?
  tips         String[]
  createdAt    DateTime           @default(now())
  sessions     SessionAnswer[]
}

model InterviewSession {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String // DSA, Behavioral, etc.
  difficulty   String // Easy, Medium, Hard
  totalQuestions Int
  totalScore   Int
  completedAt  DateTime?
  answers      SessionAnswer[]
  createdAt    DateTime         @default(now())
}

model SessionAnswer {
  id           String              @id @default(cuid())
  sessionId    String
  session      InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   String
  question     InterviewQuestion   @relation(fields: [questionId], references: [id])
  userAnswer   String
  rating       Int // 1-5 stars
  aiFeedback   String?
  strengths    String[]
  improvements String[]
  createdAt    DateTime            @default(now())
}

model CareerRoadmap {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration  String // 30, 60, 90 days
  content   String   // JSON format with week-by-week plan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" or "assistant"
  content   String
  createdAt DateTime @default(now())
}

model ResumeData {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   // Raw resume text or PDF content
  atsScore  Int?
  keywords  String[]
  score     Int?     // Recruiter impact score
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
